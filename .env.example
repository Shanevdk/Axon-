APP_NAME="Vanhaven Design Software"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Load-bearing in production. Passkeys are bound to this host by
# config/fortify.php, and invitation links are built from it, so it must be
# the public domain people actually visit.
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# SQLite locally; Laravel Cloud attaches a managed pgsql or mysql database and
# sets these five for you. The schema and queries are portable across all three.
# SQLite is right for local work and wrong for a deployed server, where the
# container filesystem is rebuilt on every release. Production runs Postgres —
# on Laravel Cloud, attach a cluster and it injects these for you.
DB_CONNECTION=sqlite
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=axon
# DB_USERNAME=postgres
# DB_PASSWORD=
#
# Or the whole thing as one string, which is what a cluster hands you:
# DB_URL="postgresql://user:pass@host-pooler.region.provider.com/axon?sslmode=require"

# --- Clustered Postgres ------------------------------------------------------
#
# Managed clusters put a pooler in front and refuse plaintext.
# DB_SSLMODE=require
#
# Point reads at a replica and they fan out to it, sticky so a request that
# writes then reads still reads from the writer. Comma-separate several.
# Leave unset for a single server and nothing changes.
# DB_READ_HOST=replica.region.provider.com
#
# Schema changes need a session of their own, which a transaction pooler will
# not give them. Set the unpooled endpoint here and deploy with:
#   php artisan migrate --force --database=pgsql_direct
# DB_DIRECT_URL="postgresql://user:pass@host.region.provider.com/axon?sslmode=require"
#
# Cache and queue default to the database, which points every hit at the
# cluster. On anything busy, move them off it.
# CACHE_STORE=redis
# QUEUE_CONNECTION=redis

# --- MongoDB -----------------------------------------------------------------
#
# A document store beside the relational core — models opt in with
# $connection = 'mongodb'. The URI carries everything: auth, replica set,
# TLS. For a managed Atlas cluster, paste its connection string here.
# Needs the mongodb PHP extension.
# MONGODB_URI=mongodb://127.0.0.1:27017
# MONGODB_DATABASE=axon

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set to true wherever the app is served over HTTPS, so the session and
# XSRF-TOKEN cookies are never sent over plain HTTP. Leave it unset locally.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# The `log` mailer writes messages to the log instead of sending them, which is
# right locally and wrong in production: organization invitations would appear
# to send and never arrive. In production set a real transport — resend,
# postmark, ses or smtp — and a MAIL_FROM_ADDRESS on a domain you have verified.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Accounts belong to the studio: only these domains may register or sign in,
# sub-domains included. Everything else is refused at every door.
WORK_EMAIL_ONLY=true
WORK_EMAIL_DOMAINS="vanhaven.ca,example.com"
# Individual addresses welcome whatever their domain.
# WORK_EMAIL_ALLOWED="shane@vdkgroup.com"

# Vanhaven assistant. Get a key at https://openrouter.ai/keys — the default model
# is free, so a key on the free tier is enough.
OPENROUTER_API_KEY=
OPENROUTER_MODEL="nvidia/nemotron-3-super-120b-a12b:free"
# Both AI calls are made inline, while the browser waits. Keep these under
# whatever request timeout your host allows or the response is cut off.
OPENROUTER_TIMEOUT=60
POLLINATIONS_TIMEOUT=120

# Claude in the editor's sidebar and in the item designer's terminal. This runs
# the Claude Code CLI on the machine serving Vanhaven, holding the app's own MCP
# server — so it works on a Claude subscription and needs no API key at all.
# Install it with `npm i -g @anthropic-ai/claude-code`.
#
# There is nothing to configure for the account: each person signs in for
# themselves from inside the app with a token from `claude setup-token`, and
# every turn is drawn from the plan of whoever asked. The host's own keychain
# sign-in is never used, so nobody can spend somebody else's subscription.
#
# This only says whether the app may run the binary at all — off unless it is
# running locally, since it executes a program on the server's machine.
# CLAUDE_CODE_ENABLED=true
# CLAUDE_CODE_BINARY=claude
# A build turn reads the model, draws, and answers, so it is slower than a chat.
# CLAUDE_CODE_TIMEOUT=180
# The PHP that starts the drawing tools. Worked out automatically — the CLI is
# not the binary serving the request (Herd serves through php-cgi, most Linux
# hosts through php-fpm, and neither can run Artisan), so the CLI beside it is
# used instead. Set this only if that guess is wrong; the symptom is Claude
# saying the `vanhaven` MCP server failed to connect.
# CLAUDE_CODE_PHP=

# Vanhaven as a connector: adding it to Claude.ai so drawings can be worked on
# from the Claude app rather than only from the editor. Nothing to configure —
# the MCP server is at /mcp/cad and Claude registers itself — but two things
# have to be true for it to work at all.
#
# APP_URL must be the public HTTPS address people actually reach, because the
# OAuth discovery documents are built from it and the `resource` field has to
# match the URL entered in Claude exactly. A .test address will not do: Claude
# reaches this server from the open internet (Anthropic egresses from
# 160.79.104.0/21), so a local install needs a tunnel.
#
# `php artisan passport:keys` must have been run on the host. The keys live in
# storage/ and are gitignored, so a fresh deployment has to generate its own,
# and regenerating them signs everybody out of their connector.

# Turns "use my location" into a place name for the editor's code consultant.
# Free and keyless; only a rounded latitude and longitude ever leave.
GEOCODER_URL="https://api.bigdatacloud.net/data/reverse-geocode-client"
GEOCODER_TIMEOUT=10

# The site picker: searching an address, and the map the pin is dropped on.
# Both are OpenStreetMap, free and keyless, and both come with conditions —
# Nominatim wants a User-Agent naming the app and no more than a request a
# second, and the tiles must carry their attribution. Answers are cached for
# a month and the search waits for a pause in typing.
#
# A studio doing enough of either to be noticed should point these at its own
# provider. Anything serving `{z}/{x}/{y}` raster tiles will do.
PLACES_URL="https://nominatim.openstreetmap.org/search"
PLACES_TIMEOUT=15
MAP_TILES_URL="https://tile.openstreetmap.org/{z}/{x}/{y}.png"
MAP_ATTRIBUTION="© OpenStreetMap contributors"

VITE_APP_NAME="${APP_NAME}"
