APP_NAME="Axon"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# SQLite locally; Laravel Cloud attaches a managed pgsql or mysql database and
# sets these five for you. The schema and queries are portable across all three.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# The `log` mailer writes messages to the log instead of sending them, which is
# right locally and wrong in production: organization invitations would appear
# to send and never arrive. In production set a real transport — resend,
# postmark, ses or smtp — and a MAIL_FROM_ADDRESS on a domain you have verified.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Axon assistant. Get a key at https://openrouter.ai/keys — the default model
# is free, so a key on the free tier is enough.
OPENROUTER_API_KEY=
OPENROUTER_MODEL="nvidia/nemotron-3-super-120b-a12b:free"
# Both AI calls are made inline, while the browser waits. Keep these under
# whatever request timeout your host allows or the response is cut off.
OPENROUTER_TIMEOUT=60
POLLINATIONS_TIMEOUT=120

VITE_APP_NAME="${APP_NAME}"
